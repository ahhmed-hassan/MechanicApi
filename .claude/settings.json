{
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Read(tests/**)",
      "Read(*.md)",
      "Read(*.json)",
      "Read(*.csproj)",
      "Read(*.sln)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet ef *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git checkout -b *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/appsettings.*.json)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(dotnet publish *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet build \"$CLAUDE_PROJECT_DIR/MechanicApi.sln\" --no-restore --verbosity quiet 2>&1 | tail -5"
          }
        ]
      }
    ]
  }
}
